# Application
APP_NAME=Alert Dashboard
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
API_KEY=your-webhook-api-key-change-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://alertuser:alertpass@db:5432/alertdb

# Redis
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=alerts@yourdomain.com
SMTP_FROM_NAME=Alert Dashboard

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_ENABLED=false

# Email notifications
EMAIL_ENABLED=false

# Alert settings
ALERT_DEDUP_WINDOW_MINUTES=5
ALERT_AUTO_RESOLVE_HOURS=24
